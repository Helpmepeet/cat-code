{
  "name": "@cat-code/desktop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "CatCode desktop app — Electron shell + Bun engine sidecar (P1-0 walking-skeleton scaffold).",
  "main": "main/main.js",
  "scripts": {
    "dev": "bun run lint:fast-refresh && bun run scripts/dev.ts",
    "sidecar:dev": "bun --feature=TRANSCRIPT_CLASSIFIER --feature=REACTIVE_COMPACT run sidecar/index.ts",
    "renderer:dev": "bun run lint:fast-refresh && vite --config renderer/vite.config.ts",
    "renderer:build": "bun run lint:fast-refresh && vite build --config renderer/vite.config.ts",
    "lint:fast-refresh": "eslint \"renderer/src/**/*.tsx\"",
    "typecheck": "bun run lint:fast-refresh && tsc --noEmit -p tsconfig.json",
    "test": "cd .. && bun test app/",
    "typecheck:sidecar": "bun run scripts/sidecar-typecheck.ts",
    "test:hardening": "bun run scripts/run-hardening-smoke.ts",
    "reap:orphans": "bun run scripts/reap-orphan-sidecars.ts",
    "preview:transcript": "bun run scripts/preview-transcript.tsx"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.0.0",
    "@tailwindcss/vite": "4.2.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^4.3.4",
    "diff": "^8.0.4",
    "electron": "^33.2.1",
    "eslint": "^9.39.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwindcss": "4.2.2",
    "unified": "^11.0.5",
    "vite": "7.3.2"
  }
}
