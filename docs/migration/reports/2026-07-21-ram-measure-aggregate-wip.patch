+const num = (xs: Array<number | null | undefined>) => xs.filter((x): x is number => typeof x === 'number')
+const maxOf = (xs: number[]) => (xs.length ? Math.max(...xs) : NaN)
+
+/** Condition name from a run label like `enrich600-r2` → `enrich600`. */
+function condOfLabel(label: string): string {
+  return label.replace(/-r\d+$/, '')
+}
+
+/**
+ * Aggregate per-condition: boot rss/footprint from the 'boot' sample; plateau
+ * from the STABLE high-water per run — max RSS (resident, monotonic) + max
+ * peak-footprint (vmmap peak, monotonic). Current physical footprint fluctuates
+ * within a run (mimalloc purges pages back to the OS — the MIMALLOC_PURGE_DELAY
+ * effect), so it is reported as a per-run-median + overall range, not a point.
+ */
+function computeAggregate(byCond: Record<string, ProbeResult[]>): Record<string, unknown> {
+  const agg: Record<string, unknown> = {}
+  for (const [name, rs] of Object.entries(byCond)) {
+    const boot = rs.map(r => r.samples.find(s => s.label === 'boot'))
+    const perRun = rs.map(r => {
+      const attached = r.samples.filter(s => s.label.startsWith('attached'))
+      return {
+        maxRss: maxOf(num(attached.map(s => s.rssMB))),
+        maxPeakFp: maxOf(num(attached.map(s => s.footprintPeakMB))),
+        curFpValues: num(attached.map(s => s.footprintMB)),
+      }
+    })
+    const hasAttached = perRun.some(p => p.curFpValues.length > 0)
+    agg[name] = {
+      reps: rs.length,
+      allKillVerified: rs.every(r => r.killVerified),
+      allReady: rs.every(r => r.reachedReady),
+      boot: {
+        rssMB: { median: median(num(boot.map(b => b?.rssMB))), values: num(boot.map(b => b?.rssMB)) },
+        footprintMB: { median: median(num(boot.map(b => b?.footprintMB))), values: num(boot.map(b => b?.footprintMB)) },
+      },
+      ...(hasAttached ? {
+        plateau: {
+          maxRssMB: { median: median(perRun.map(p => p.maxRss)), values: perRun.map(p => p.maxRss) },
+          maxPeakFootprintMB: { median: median(perRun.map(p => p.maxPeakFp)), values: perRun.map(p => p.maxPeakFp) },
+          currentFootprintMB: (() => {
+            const all = perRun.flatMap(p => p.curFpValues)
+            return {
+              medianOfPerRunMedian: median(perRun.map(p => median(p.curFpValues))),
+              overallMin: all.length ? Math.min(...all) : NaN,
+              overallMax: all.length ? Math.max(...all) : NaN,
+            }
+          })(),
+        },
+      } : {}),
+    }
+  }
+  return agg
+}
+
+/** Aggregate-only: read every retained `<out>/*.result.json` and write the
+ * cross-chunk `ram0-aggregate.json`. This makes chunked execution (one
+ * background task per rep, to stay under the wall-clock cap) aggregatable. */
+function aggregateOnly(outDir: string): void {
+  const files = readdirSync(outDir).filter(f => f.endsWith('.result.json'))
+  const byCond: Record<string, ProbeResult[]> = {}
+  for (const f of files) {
+    try {
+      const r = JSON.parse(readFileSync(join(outDir, f), 'utf8')) as ProbeResult
+      ;(byCond[condOfLabel(r.label)] ??= []).push(r)
+    } catch {
+      process.stderr.write(`aggregate: skipping unparseable ${f}\n`)
+    }
+  }
+  const summary = {
+    runner: 'app/scripts/ram-measure.ts --aggregate-only',
+    resultFiles: files.length,
+    aggregate: computeAggregate(byCond),
+    runs: Object.values(byCond).flat().map(r => ({ label: r.label, killVerified: r.killVerified, reachedReady: r.reachedReady })),
+  }
+  writeFileSync(join(outDir, 'ram0-aggregate.json'), JSON.stringify(summary, null, 2) + '\n')
+  process.stdout.write(JSON.stringify(summary, null, 2) + '\n')
+}
